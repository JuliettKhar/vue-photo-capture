{
  "name": "vue-photo-capture",
  "version": "1.2.0",
  "description": "A Vue 3 Composition API library for capturing photos using a webcam or camera device.",
  "main": "dist/vue-photo-capture.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "lint": "eslint src",
    "test": "jest",
    "deploy": "npm publish --non-interactive  --verbose",
    "predeploy:demo": "npm run build && rm -rf .gh-demo && mkdir -p .gh-demo/dist && cp index.html .gh-demo/ && cp dist/vue-photo-capture.umd.js dist/vue-photo-capture.mjs .gh-demo/dist/",
    "deploy:demo": "gh-pages -d .gh-demo -b gh-pages -m \"Deploy demo\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JuliettKhar/vue-photo-capture.git"
  },
  "keywords": [
    "typescript",
    "vue",
    "composition-api",
    "vue3"
  ],
  "author": "Julia Kharlamova",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@jest/globals": "~30.2.0",
    "@types/jest": "~29.5.12",
    "@vitejs/plugin-vue": "~6.0.8",
    "@vue/eslint-config-typescript": "~14.9.0",
    "@vue/test-utils": "~2.4.6",
    "eslint": "~10.7.0",
    "eslint-plugin-vue": "~10.10.0",
    "gh-pages": "^6.3.0",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "~29.7.0",
    "lint-staged": "~15.5.1",
    "ts-jest": "~29.2.4",
    "typescript": "~5.9.3",
    "vite": "~8.1.5",
    "vite-plugin-dts": "~4.5.4",
    "vue": "~3.5.11"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  }
}
