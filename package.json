{
  "name": "vue-photo-capture",
  "version": "1.8.0",
  "description": "A Vue 3 Composition API library for capturing photos using a webcam or camera device.",
  "main": "dist/vue-photo-capture.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-photo-capture.mjs",
      "require": "./dist/vue-photo-capture.umd.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "serve": "vite",
    "build": "vite build && vite build --config vite.nuxt.config.mjs",
    "lint": "eslint src",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deploy": "npm publish --non-interactive  --verbose",
    "predeploy:site": "npm run build && npm run docs:build && rm -rf .gh-site && mkdir -p .gh-site/demo/dist && cp -R docs/.vitepress/dist/. .gh-site/ && cp index.html .gh-site/demo/ && cp dist/vue-photo-capture.umd.js dist/vue-photo-capture.mjs .gh-site/demo/dist/ && touch .gh-site/.nojekyll",
    "deploy:site": "gh-pages -d .gh-site -b gh-pages -m \"Deploy docs + demo\" --dotfiles"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JuliettKhar/vue-photo-capture.git"
  },
  "keywords": [
    "typescript",
    "vue",
    "composition-api",
    "vue3"
  ],
  "author": "Julia Kharlamova",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@jest/globals": "~30.4.1",
    "@nuxt/kit": "^4.5.0",
    "@playwright/test": "^1.62.0",
    "@types/jest": "~30.0.0",
    "@vitejs/plugin-vue": "~6.0.8",
    "@vue/eslint-config-typescript": "~14.9.0",
    "@vue/test-utils": "~2.4.6",
    "eslint": "~10.8.0",
    "eslint-plugin-vue": "~10.10.0",
    "gh-pages": "^6.3.0",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "~30.4.1",
    "lint-staged": "~15.5.1",
    "ts-jest": "~29.4.12",
    "typescript": "~5.9.3",
    "vite": "~8.1.5",
    "vite-plugin-dts": "~4.5.4",
    "vitepress": "^1.6.4",
    "vue": "~3.5.11"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "@nuxt/kit": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  }
}
